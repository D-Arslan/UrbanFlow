# Copy this file to `.env` and adjust the values. `.env` is never versioned (.gitignore).
# Every variable read by the code or by docker-compose.yml is listed here.

# --- PostgreSQL (docker-compose + api/config.py + spark/streaming_job.py + docs/make_figures.py)
POSTGRES_USER=urbanflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=urbanflow
# Host-side connection (API / dashboard / figures run in the host venv): localhost.
# POSTGRES_PORT is BOTH the port docker-compose publishes AND the port the API connects to,
# so they cannot diverge. Use 5433 if a native PostgreSQL already owns 5432.
# Inside the Docker network, Spark uses postgres:5432 regardless of this value.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MinIO (S3-compatible object store for the cold Parquet history)
# ROOT_USER = S3 access key ; ROOT_PASSWORD = S3 secret key (8 characters minimum).
MINIO_ROOT_USER=urbanflow
MINIO_ROOT_PASSWORD=change-me-too
# Endpoint as seen by the Spark jobs (container side). Set by docker-compose for the spark
# service; only needed here if you run a job outside compose.
MINIO_ENDPOINT=http://minio:9000

# --- Kafka
# Host-side clients (ingestion/poller.py, consumer/peek_topic.py): the advertised PLAINTEXT
# listener. Containers (Spark) use the INTERNAL listener kafka:29092, set by docker-compose.
KAFKA_BOOTSTRAP=localhost:9092

# --- Dashboard (dashboard/data.py): base URL of the FastAPI service
API_URL=http://localhost:8000
